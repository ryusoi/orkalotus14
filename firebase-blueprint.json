{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Configurable service, management, or staff ranking category for Orka Lotus Beach Hotel",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Category name",
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "enum": ["service", "management", "staff"],
          "description": "Category domain type"
        },
        "description": {
          "type": "string",
          "description": "Short description of the category",
          "maxLength": 500
        },
        "icon": {
          "type": "string",
          "description": "Lucide icon identifier",
          "maxLength": 50
        },
        "active": {
          "type": "boolean",
          "description": "Whether category is active for guest evaluations"
        },
        "displayOrder": {
          "type": "number",
          "description": "Numeric display sort index"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["name", "type", "active", "displayOrder"]
    },
    "Person": {
      "title": "Person",
      "description": "Management leadership or staff member profile for Orka Lotus Beach Hotel",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full professional name",
          "maxLength": 120
        },
        "position": {
          "type": "string",
          "description": "Official title or role",
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "description": "Hotel operational department",
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "enum": ["management", "staff"],
          "description": "Person tier"
        },
        "photoUrl": {
          "type": "string",
          "description": "Profile photograph URL or asset path",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "description": "Short biography or service philosophy",
          "maxLength": 1000
        },
        "active": {
          "type": "boolean",
          "description": "Active status for guest ratings"
        },
        "displayOrder": {
          "type": "number",
          "description": "Numeric sort order"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["name", "position", "department", "type", "active", "displayOrder"]
    },
    "Rating": {
      "title": "Rating",
      "description": "Guest experience evaluation submission for a service, manager, or staff member",
      "type": "object",
      "properties": {
        "targetId": {
          "type": "string",
          "description": "ID of the category or person evaluated",
          "maxLength": 128
        },
        "targetType": {
          "type": "string",
          "enum": ["service", "management", "staff"],
          "description": "Type of target evaluated"
        },
        "targetName": {
          "type": "string",
          "description": "Snapshot of target name at submission",
          "maxLength": 120
        },
        "overallRating": {
          "type": "number",
          "description": "Overall rating between 1 and 5"
        },
        "hospitalityRating": {
          "type": "number",
          "description": "Hospitality dimension score (1-5)"
        },
        "professionalismRating": {
          "type": "number",
          "description": "Professionalism dimension score (1-5)"
        },
        "helpfulnessRating": {
          "type": "number",
          "description": "Helpfulness dimension score (1-5)"
        },
        "courtesyRating": {
          "type": "number",
          "description": "Courtesy dimension score (1-5)"
        },
        "qualityRating": {
          "type": "number",
          "description": "Quality dimension score (1-5)"
        },
        "recommendation": {
          "type": "string",
          "enum": ["absolutely", "yes", "maybe", "probably_not"],
          "description": "Guest recommendation decision"
        },
        "comment": {
          "type": "string",
          "description": "Optional written guest praise or comment",
          "maxLength": 500
        },
        "guestDisplayName": {
          "type": "string",
          "description": "Optional guest display name (e.g. Verified Guest)",
          "maxLength": 100
        },
        "anonymous": {
          "type": "boolean",
          "description": "Whether rating is marked anonymous"
        },
        "submissionSessionId": {
          "type": "string",
          "description": "Hashed client session identifier for anti-spam rate limiting",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission server timestamp"
        }
      },
      "required": [
        "targetId",
        "targetType",
        "overallRating",
        "hospitalityRating",
        "professionalismRating",
        "helpfulnessRating",
        "courtesyRating",
        "qualityRating",
        "recommendation",
        "submissionSessionId"
      ]
    },
    "RatingSummary": {
      "title": "RatingSummary",
      "description": "Aggregated ranking metrics for a service, manager, or staff member",
      "type": "object",
      "properties": {
        "targetId": {
          "type": "string",
          "description": "Target ID matching category or person",
          "maxLength": 128
        },
        "targetType": {
          "type": "string",
          "enum": ["service", "management", "staff"],
          "description": "Target classification"
        },
        "totalRatings": {
          "type": "number",
          "description": "Total number of verified ratings"
        },
        "averageOverall": {
          "type": "number",
          "description": "Calculated average overall score (1.0 - 5.0)"
        },
        "averageHospitality": {
          "type": "number",
          "description": "Average hospitality dimension score"
        },
        "averageProfessionalism": {
          "type": "number",
          "description": "Average professionalism dimension score"
        },
        "averageHelpfulness": {
          "type": "number",
          "description": "Average helpfulness dimension score"
        },
        "averageCourtesy": {
          "type": "number",
          "description": "Average courtesy dimension score"
        },
        "averageQuality": {
          "type": "number",
          "description": "Average quality dimension score"
        },
        "recommendationPercentage": {
          "type": "number",
          "description": "Percentage of guests recommending this experience (0 - 100)"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of most recent aggregated update"
        }
      },
      "required": [
        "targetId",
        "targetType",
        "totalRatings",
        "averageOverall",
        "recommendationPercentage"
      ]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Master list of configurable services and ranking categories"
    },
    "/people/{personId}": {
      "schema": { "$ref": "#/entities/Person" },
      "description": "Official management and hospitality personnel ranking profiles"
    },
    "/ratings/{ratingId}": {
      "schema": { "$ref": "#/entities/Rating" },
      "description": "Immutable guest ratings and feedback records"
    },
    "/ratingSummaries/{targetId}": {
      "schema": { "$ref": "#/entities/RatingSummary" },
      "description": "Cached statistical aggregate summaries for fast free-first public queries"
    }
  }
}
